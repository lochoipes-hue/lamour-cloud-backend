# DaiLo Wedding — Render Backend Environment Variables Example
# Copy into Render Dashboard -> Environment -> Environment Variables (NEVER commit real secrets to Git!)

PORT=3000
NODE_ENV=production

# 1. Persistent Database (REQUIRED on Render Free so data/orders/photos are NEVER wiped on redeploy/sleep)
# Recommended FREE forever: Neon.tech (https://neon.tech) or Supabase (https://supabase.com) PostgreSQL URI
DATABASE_URL=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Alternative for Render Paid Starter ($7/mo) + Persistent Disk ($0.25/GB): leave DATABASE_URL empty & set:
# DATA_DIR=/var/data

# 2. Frontend URL on Vercel (used for CORS allowlist + OAuth login redirect back to Vercel)
FRONTEND_URL=https://lamour-thiep-cuoi.vercel.app
# Optional extra custom domains (comma-separated)
# ALLOWED_ORIGINS=https://thiepcuoi.yourdomain.vn,https://www.thiepcuoi.yourdomain.vn

# 3. SePay / Casso / PayOS Bank Webhook Secret (MB Bank 0354248177 auto-handover)
SEPAY_API_KEY=replace_with_your_sepay_api_key

# 4. Gemini AI Agent Consultant (Optional — free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 5. Direct Social Login & Account Linking (Facebook & Google OAuth 2.0)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 6. Real Email & SMS OTP Gateways (Gmail & 10-digit VN Phone verification)
# Email OTP: configure Resend, Brevo, or custom Email Webhook
RESEND_API_KEY=
BREVO_API_KEY=
MAIL_FROM=DaiLo Wedding <onboarding@resend.dev>
OTP_EMAIL_WEBHOOK_URL=

# SMS OTP: configure eSMS.vn, Twilio, or custom SMS/Zalo ZNS Webhook
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OTP_SMS_WEBHOOK_URL=
OTP_WEBHOOK_SECRET=
